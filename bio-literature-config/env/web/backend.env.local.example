DATABASE_URL=sqlite:///./bio_digest_web.db
SHARED_DATABASE_URL=sqlite:///./bio_literature_shared.db
FRONTEND_ORIGIN=http://127.0.0.1:18001
SESSION_SECRET=change-me
SESSION_COOKIE_SECURE=false
WEB_BASE_URL=http://127.0.0.1:18001
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN=true
DATA_RETENTION_DAYS=30
# Optional: set an absolute producer root when the archive source is not at the default sibling location.
# PRODUCER_ROOT=/ABSOLUTE/PATH/TO/bio-literature-digest

# 登录方式：true=两步式邮箱验证码（OTP，默认）；false=旧式免密直登（仅回退用）
OTP_LOGIN_ENABLED=true
# 验证码有效期（秒）、位数、最大尝试次数、重发冷却（秒）
OTP_CODE_TTL_SECONDS=600
OTP_CODE_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# 发送限流：同邮箱每小时/每日、同 IP 每小时
OTP_PER_EMAIL_HOURLY_LIMIT=5
OTP_PER_EMAIL_DAILY_LIMIT=15
OTP_PER_IP_HOURLY_LIMIT=20
# 本地开发无 agently-cli 时置 true：验证码不发信，直接在响应里回显（生产严禁开启）
OTP_DEV_ECHO=false
